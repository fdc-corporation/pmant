<?xml version="1.0" encoding="utf-8"?>
<template id="template" xml:space="preserve">
    <t t-name="FormStatusIndicator" t-inherit="web.FormStatusIndicator" t-inherit-mode="extension" owl="1" >
        <xpath expr="//div[contains(@class, 'o_form_status_indicator')]" position="replace">
            <div class="o_form_status_indicator d-md-flex align-items-center align-self-md-end me-auto"
                 t-att-class="{ o_form_status_indicator_new_record: props.model.root.isNew }">
                <div class="o_form_status_indicator_buttons d-flex gap-2"
                     t-att-class="{ invisible: !(props.model.root.isNew or displayButtons) }">
                    
                     <button
                        type="button"
                        class="o_form_button_save btn btn-primary pt-1 pb-1 px-1 py-0 lh-sm"
                        data-hotkey="s"
                        t-on-click.stop="save"
                        data-tooltip="Save manually"
                        aria-label="Save manually"
                        t-ref="save">
                        Guardar 
                        <i class="fa fa-cloud-upload fa-fw" />
                    </button>
                    <button
                        type="button"
                        class="o_form_button_cancel btn btn-secondary pt-1 pb-1 px-1 py-0 lh-sm"
                        data-hotkey="j"
                        t-on-click.stop="discard"
                        data-tooltip="Discard changes"
                        aria-label="Discard changes">
                        Cancelar 
                        <i class="fa fa-undo fa-fw" />
                    </button>
                </div>
                <span
                    t-if="!props.model.root.isNew and indicatorMode === 'invalid'"
                    class="text-danger small ms-2"
                    data-tooltip="Unable to save. Correct the issue or discard changes">
                    <i class="fa fa-warning" />
                </span>
            </div>
        </xpath>
    </t>
</template>
