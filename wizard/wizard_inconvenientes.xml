<odoo>
    <record id="view_wizars_inconvenientes" model="ir.ui.view">
        <field name="name">wizars.inconvenientes.form</field>
        <field name="model">wizars.inconvenientes</field>
        <field name="arch" type="xml">
            <form string="Compartir Ot">
                <group>
                    <field name="programacion_id" readonly="1" />
                    <field name="ot_id" readonly="1" />
                    <field name="tarea_id" readonly="1" />
                    <field name="is_finalizo_servicio" />
                    <field name="file_ref" invisible="is_finalizo_servicio" />
                    <field name="comentario" invisible="is_finalizo_servicio" />
                </group>
                <footer>
                    <button string="Guardar" type="object" name="action_set_data" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>