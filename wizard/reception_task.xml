<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pmant_reception_task_wizard_form" model="ir.ui.view">
        <field name="name">pmant.reception.task.wizard.form</field>
        <field name="model">pmant.reception.task.wizard</field>
        <field name="arch" type="xml">
            <form string="Crear tarea desde recepción">
                <group>
                    <field name="reception_id"/>
                    <field name="service_type_id" options="{'no_create': True, 'no_create_edit': True}"/>
                    <field name="plan_id" options="{'no_create': True, 'no_create_edit': True}"/>
                </group>
                <footer>
                    <button name="action_create_task" string="Crear tarea" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
