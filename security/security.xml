<odoo>

<!--Registros de grupos en el modelo ( tabla ) res.groups-->

    
    <record model="res.groups.privilege" id="res_group_pmant_category">
        <field name="name">Pmant</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>
    <record model="res.groups.privilege" id="res_hroup_pmant_privilege_alert">
        <field name="name">Pmant - Notificacion facturacion</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record model="res.groups" id="group_pmant_planner">
        <field name="name">Mantenimiento - Planner</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_group_pmant_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Usuario planner de mantenimiento.</field>
    </record>
    <record model="res.groups" id="group_pmant_admin">
        <field name="name">Mantenimiento - Admin</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_group_pmant_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Usuario tecnico de mantenimiento.</field>
    </record>
    <record model="res.groups" id="group_pmant_tecnico">
        <field name="name">Mantenimiento - Tecnico</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_group_pmant_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Usuario tecnico de mantenimiento.</field>
    </record>
    <record model="res.groups" id="group_pmant_vendedor">
        <field name="name">Mantenimiento - Vendedor</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_group_pmant_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Usuario vendedor de mantenimiento.</field>
    </record>

    <record model="res.groups" id="group_pmant_user_notifi_fac">
        <field name="name">Mantenimiento - Notificacion facturacion</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_hroup_pmant_privilege_alert"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Usuario que recibe notificaciones de facturacion de mantenimiento.</field>

    </record>


