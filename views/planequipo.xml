<?xml version="1.0" encoding="UTF-8"?>
<odoo>
	<record model="ir.actions.act_window" id="planequipo_list_action">
		<field name="name">Tarea  Asignada</field>
		<field name="res_model">planequipo.mantenimiento</field>
		<!-- <field name="view_type">form</field> -->
		<field name="view_mode">kanban,tree,form</field>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">Crea tu primera Plan Equipo</p>
		</field>
	</record>
	<record id="planequios_tree_view" model="ir.ui.view">
		<field name="name">planequipo.tree</field>
		<field name="model">planequipo.mantenimiento</field>
		<field name="arch" type="xml">
			<tree string="PlanEquipo Tree">
				<field name="equipo" />
				<field name="plan" string="Plan de Mantenimiento"  />
				<field name="estado" />
				<field name="fecha_ejec" string="Fecha Ejecutada" />
				<!-- <button name="%(pmant.action_plan_equipo)d" string="Reporte" type="action"/> -->
			</tree>
		</field>
	</record>
	<record model="ir.ui.view" id="PlanEquipov_form_view">
		<field name="name">planequipo.form</field>
		<field name="model">planequipo.mantenimiento</field>
		<field name="arch" type="xml">
			<form string="Tarea Form">
				<sheet>
					<field name="is_admin" invisible="1" />
					<group>
						<!-- Campos de cabecera -->
						<field name="id" invisible="1"/>
						<field name="cliente"  readonly="1"/>
						<field name="ubicacion" readonly="1"/>
						<field name="tarea" invisible="1"/>
						<field name="ots" invisible="1"/>
						<field name="equipo" domain="[('ubicacion', '=', ubicacion) ('propietario','=', cliente)]" readonly="not is_admin and not tarea.is_evaluacion"/>
						<!-- <field name="equipo" options="{'no_open': True}"/> -->
						<field name="plan" string="Plan de mantenimiento" readonly="not is_admin and not tarea.is_evaluacion"/>
						<field name="fecha_ejec"/>
						<field name="fecha_ejecprox" string="Próxima Fecha de Mantenimiento"/>
						<field name="fecha_hoy" invisible="1"/>
					</group>
					<notebook>
						<!-- Procesos de mantenimiento -->
						<page string="Procesos de Mantenimiento" invisible="is_admin" >
							<field name="procesos" nolabel="1" >
								<tree >
									<field name="estado"/>
									<field name="proceso"/>
									<field name="descripcion"/>
								</tree>
							</field>
						</page>
						<!-- Voltaje -->
						<page string="Voltaje de Alimentación" invisible="is_admin" >
							<field name="voltaje_ids" nolabel="1" >
								<tree editable="bottom">
									<field name="l1_l2"/>
									<field name="l2_l3"/>
									<field name="l1_l3"/>
									<field name="l1_gnd"/>
									<field name="l2_gnd"/>
									<field name="l3_gnd"/>
									<field name="supply"/>
								</tree>
							</field>
						</page>
						<!-- Amperaje -->
						<page string="Corriente de Motor Principal" invisible="is_admin" >
							<field name="amperaje_ids" nolabel="1" >
								<tree editable="bottom">
									<field name="linea"/>
									<field name="carga_linea"/>
									<field name="descarga_linea"/>
									<field name="fase"/>
									<field name="carga_fase"/>
									<field name="descarga_fase"/>
								</tree>
							</field>
						</page>
						<!-- Parámetros de operación -->
						<page string="Parámetros de operación del compresor" invisible="is_admin" >
							<field name="parametro_ids" nolabel="1" >
								<tree editable="bottom">
									<field name="paremetro_id"/>
									<field name="valor_trabajo"/>
									<field name="valor_parada"/>
									<field name="unidad_medida"/>
								</tree>
							</field>
						</page>
						<page string="Conclusiones" invisible="is_admin">
							<group>
								<field name="nota_observaciones" widget="html" invisible="is_admin" />
								<field name="nota_mantenimiento" widget="html" invisible="is_admin" />
								<field name="nota_recomendaciones" widget="html" invisible="is_admin" />
							</group>
						</page>
					</notebook>
					
				</sheet>
			</form>

		</field>
	</record>
	<record model="ir.ui.view" id="planequipo_kanban">
		<field name="name">planequipo.mantenimiento.kanban</field>
		<field name="model">planequipo.mantenimiento</field>
		<field name="arch" type="xml">
			<kanban default_group_by="tarea">
				<field name="plan" />
				<templates>
					<t t-name="kanban-box">
						<div t-attf-class="oe_kanban_global_click_edit oe_semantic_html_override oe_kanban_card ">
							<div class="oe_dropdown_kanban">
								<!-- dropdown menu -->
								<div class="oe_dropdown_toggle">
									<i class="fa fa-bars fa-lg" title="Manage" aria-label="Manage" />
									<ul class="oe_dropdown_menu">
										<li>
											<a type="delete">
												Delete
											</a>
										</li>
										<li>
											<ul class="oe_kanban_colorpicker" data-field="color" />
										</li>
									</ul>
								</div>
								<div class="oe_clear">
								</div>
							</div>
							<div t-attf-class="oe_kanban_content">
								<!-- title -->
								Plan de Tarea:
								<field name="plan" />
								<br />
								Equipo:
								<field name="equipo" />
								<br />
								Procesos:
								<field name="procesos" />
							</div>
						</div>
					</t>
				</templates>
			</kanban>
		</field>
	</record>
	<menuitem id="planequipo_menuv" name="OTS asignadas" parent="maintenance.menu_maintenance_title" action="planequipo_list_action" />
</odoo>
