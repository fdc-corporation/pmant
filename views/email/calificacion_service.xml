<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="email_template_calificacion_servicio" model="mail.template">
	<field name="name">Calificacion de servicio</field>
    <field name="model_id" ref="maintenance.model_maintenance_request"/>
    <field name="subject">¡Califica nuestro servicio!</field>
    <field name="email_from">{{ (user.email_formatted or object.user_id.email_formatted) }}</field>
    <field name="email_to">{{ object.ubicacion.email }}</field>
    <field name="lang">{{ object.partner_id.lang }}</field>
    <!-- <field name="report_template_ids" eval="[(4, ref('pmant.action_mantenimiento_ot'))]" /> -->

    <field name="body_html">
        <![CDATA[
           <p style="margin:0px 0 16px 0;box-sizing:border-box;"><br></p>
    <table>
        <tbody style="border: 0; box-sizing: border-box; padding: 10px;">
            <tr style="border: 0; box-sizing: border-box; padding: 10px; text-align: center;">
                <td style="padding: 10px;">
                    <h2 style="margin:0px 0 8px 0; font-size:21px; color:#111827; line-height:1.2; font-weight:500;">
                        ¡Califica nuestro servicio!
                    </h2>
                </td>
            </tr>
            <tr style="border: 0; box-sizing: border-box; padding: 10px;">
                <td style="padding: 10px;">
                    Hola <t t-out="object.empresa.name">FDC CORP</t>, <br>
                    Nos encantaría conocer su calificación sobre la calidad y atención de nuestro servicio 
                    <strong t-out="object.name"></strong>
                </td>
            </tr>
    
            <tr style="border: 0; box-sizing: border-box; padding: 10px;">
                <td style="padding: 10px; text-align: center;">
                    <table style="width: 300px; border-radius: 4px; margin: 0 auto; border: 1px solid blue;">
                        <tr>
                            <t t-set="base_url" t-value="object.get_base_url()"/>
                            <td style="border-right: 1px solid black; text-align: center;">
                                <a t-att-href="base_url + '/rate_service?rating=1&order_id=' + str(object.tarea.id)" style="text-decoration: none; font-size: 18px;">1</a>
                            </td>
                            <td style="border-right: 1px solid black; text-align: center;">
                                <a t-att-href="base_url + '/rate_service?rating=2&order_id=' + str(object.tarea.id)"" style="text-decoration: none; font-size: 18px;">2</a>
                            </td>
                            <td style="border-right: 1px solid black; text-align: center;">
                                <a t-att-href="base_url + '/rate_service?rating=3&order_id=' + str(object.tarea.id)"" style="text-decoration: none; font-size: 18px;">3</a>
                            </td>
                            <td style="border-right: 1px solid black; text-align: center;">
                                <a t-att-href="base_url + '/rate_service?rating=4&order_id=' + str(object.tarea.id)"" style="text-decoration: none; font-size: 18px;">4</a>
                            </td>
                            <td style="text-align: center;">
                                <a t-att-href="base_url + '/rate_service?rating=5&order_id=' + str(object.tarea.id)"" style="text-decoration: none; font-size: 18px;">5</a>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
    
            <tr style="border: 0; box-sizing: border-box; padding: 10px;">
                <td style="padding: 10px;">
                    <span style="font-size: 11px;color: gray;">
                        Si aún no cuentas con un usuario para nuestro portal, contacte a 
                        <a t-att-href="'tel:' + str(object.create_uid.company_id.mobile)"
                        style="text-decoration:none;color:#008f8c;">+51 908 912 551</a> 
                        para obtener acceso a todos sus servicios.
                    </span>
                </td>
            </tr>
        </tbody>
    </table>
        ]]>
    </field>
	</record>
</odoo>
