<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="email_template_servicio_finalizado" model="mail.template">
        <field name="name">Orden de Trabajo finalizado</field>
        <field name="model_id" ref="maintenance.model_maintenance_request"/>
        <field name="subject">Orden de trabajo Finalizado: {{ object.ubicacion.name }}</field>
        <field name="email_from">{{ (user.email_formatted or object.user_id.email_formatted) }}</field>
        <field name="email_to">{{ object.ubicacion.email }}</field>
        <field name="lang">{{ object.partner_id.lang }}</field>

        <field name="body_html" type="html">
            <t t-set="base_url" t-value="object.get_base_url()"/>
            <table style="width:700px; margin:30px auto; border:1px solid #d6d6d6; border-radius:5px; background-color:white; padding:10px;">
                <tr>
                    <td style="text-align:center; padding:10px;">
                        <h2 style="font-size:21px; color:#111827;">Servicio completada!</h2>
                    </td>
                </tr>
                <tr>
                    <td style="padding:10px;">
                        Hola <t t-esc="object.empresa.name or 'Cliente'"/><br/>
                        Queremos informarte que tu servicio
                        <strong><t t-esc="object.name"/></strong> ya se finalizó,
                        puedes consultar la información del servicio en nuestro portal:
                    </td>
                </tr>
                <tr>
                    <td style="padding:10px;">
                        <h4 style="font-size:16px; color:#111827;">Detalles del servicio:</h4>
                        <t t-foreach="object.tarea.planequipo" t-as="equipo">
                            <ul>
                                <li>
                                    <strong>Equipo:</strong> <t t-esc="equipo.equipo.name"/>
                                    <a t-att-href="base_url + '/my/equipo/' + str(equipo.equipo.id) + '/historial/'"
                                       style="background:#714b67; color:white; padding:2px 4px; border-radius:3px; text-decoration:none;">
                                        Ir a mi servicio
                                    </a>
                                </li>
                                <li><strong>Marca:</strong> <t t-esc="equipo.equipo.marca"/></li>
                                <li><strong>Modelo:</strong> <t t-esc="equipo.equipo.model"/></li>
                                <li><strong>N° de serie:</strong> <t t-esc="equipo.equipo.serial_no"/></li>
                                <li><strong>Plan de mantenimiento:</strong> <t t-esc="equipo.plan.name"/></li>
                            </ul>
                        </t>
                    </td>
                </tr>
                <tr>
                    <td style="padding:10px; font-size:11px; color:gray;">
                        Si aún no cuentas con un usuario para nuestro portal,
                        contacte a <a t-att-href="'tel:' + (object.company_id.phone or '')"
                                     style="color:#008f8c; text-decoration:none;">
                                     <t t-esc="object.company_id.phone or ''"/>
                        </a> para obtener acceso a todos sus servicios.
                    </td>
                </tr>
            </table>

            <div style="width:700px; margin:30px auto;">
                <table>
                    <tr>
                        <td style="padding-right:10px;">
                            <img t-att-src="'/logo.png?company=' + str(object.company_id.id)" width="120px"/>
                        </td>
                        <td>
                            <strong><t t-esc="object.company_id.name"/></strong><br/>
                            <span><t t-esc="object.company_id.street or ''"/></span><br/>
                            <span><t t-esc="object.company_id.phone or ''"/></span>
                        </td>
                    </tr>
                </table>
            </div>
        </field>
    </record>
</odoo>
