<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="email_template_servicio_finalizado" model="mail.template">
	<field name="name">Orden de Trabajo finalizado</field>
    <field name="model_id" ref="maintenance.model_maintenance_request"/>
    <field name="subject">Orden de trabajo Finalizado: {{ object.ubicacion.name }}</field>
    <field name="email_from">{{ (user.email_formatted or object.user_id.email_formatted) }}</field>
    <field name="email_to">{{ object.ubicacion.email }}</field>
    <field name="lang">{{ object.partner_id.lang }}</field>
    <!-- <field name="report_template_ids" eval="[(4, ref('pmant.action_mantenimiento_ot'))]" /> -->

    <field name="body_html">
        <![CDATA[
            <p style="margin:0px 0 16px 0;box-sizing:border-box;"><br></p>
            <table
                style="border-style:solid;box-sizing:border-box;border-left-color:#d6d6d6;border-bottom-color:#d6d6d6;border-right-color:#d6d6d6;border-top-color:#d6d6d6;border-left-width:1px;border-bottom-width:1px;border-right-width:1px;border-top-width:1px;border-collapse:collapse;caption-side:bottom;width: 700px; margin: 30px auto;border:1px solid #d6d6d6;padding: 10px; border-radius: 5px; background-color: white;"
                width="700">
                <tbody
                    style="border-style:solid;box-sizing:border-box;border-left-width:0px;border-bottom-width:0px;border-right-width:0px;border-top-width:0px;border-left-color:inherit;border-bottom-color:inherit;border-right-color:inherit;border-top-color:inherit;padding: 10px; ">
                    <tr
                        style="border-style:solid;box-sizing:border-box;border-left-width:0px;border-bottom-width:0px;border-right-width:0px;border-top-width:0px;border-left-color:inherit;border-bottom-color:inherit;border-right-color:inherit;border-top-color:inherit;padding: 10px; ">
                        <td
                            style="border-style:solid;box-sizing:border-box;border-left-width:0px;border-bottom-width:0px;border-right-width:0px;border-top-width:0px;border-left-color:inherit;border-bottom-color:inherit;border-right-color:inherit;border-top-color:inherit;text-align: center; padding: 10px;">
                            <h2
                                style="margin:0px 0 8px 0;box-sizing:border-box;font-size:21px;color:#111827;line-height:1.2;font-weight:500;font-family:'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Ubuntu, 'Noto Sans', Arial, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji';">
                                ¡Reparación completada!</h2>
                        </td>
                    </tr>
                    <tr
                        style="border-style:solid;box-sizing:border-box;border-left-width:0px;border-bottom-width:0px;border-right-width:0px;border-top-width:0px;border-left-color:inherit;border-bottom-color:inherit;border-right-color:inherit;border-top-color:inherit;padding: 10px; ">
                        <td
                            style="border-style:solid;box-sizing:border-box;border-left-width:0px;border-bottom-width:0px;border-right-width:0px;border-top-width:0px;border-left-color:inherit;border-bottom-color:inherit;border-right-color:inherit;border-top-color:inherit;padding: 10px;">
                            Hola <t t-esc="object.empresa.name">FDC CORP</t> <br>
                            Queremos informarte que tu servicio <strong style="box-sizing:border-box;font-weight:bolder;"
                                t-esc="object.name">MC
                                reparación de hidro lavadora</strong>&nbsp;ya se
                            finalizo,
                            puedes consultar la información del servicio por equipo en nuestro portal:
                        </td>
                    </tr>
                    <tr
                        style="border-style:solid;box-sizing:border-box;border-left-width:0px;border-bottom-width:0px;border-right-width:0px;border-top-width:0px;border-left-color:inherit;border-bottom-color:inherit;border-right-color:inherit;border-top-color:inherit;padding: 10px; ">
                        <td
                            style="border-style:solid;box-sizing:border-box;border-left-width:0px;border-bottom-width:0px;border-right-width:0px;border-top-width:0px;border-left-color:inherit;border-bottom-color:inherit;border-right-color:inherit;border-top-color:inherit;padding: 10px;">
                            <h4
                                style="margin:0px 0 8px 0;box-sizing:border-box;font-size:16.8px;color:#111827;line-height:1.2;font-weight:500;font-family:'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Ubuntu, 'Noto Sans', Arial, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji';">
                                Detalles del servicio:</h4>
                            <t t-foreach="object.tarea.planequipo" t-as="equipo">
                                <ul
                                    style="padding:0 0 0 32px;margin:0px 0 16px 0;box-sizing:border-box;list-style-type:disc;font-size: 15px;">
                                    <li><strong style="box-sizing:border-box;font-weight:bolder;"><span class="base-fs"
                                                style="box-sizing:border-box;font-size:14px;">Equipo: </span></strong><span
                                            t-esc="equipo.equipo.name" class="base-fs"
                                            style="box-sizing:border-box;font-size:14px;">Hidrolavadora Karcher 10/25</span>
                                        <a t-att-href="object.get_base_url() + '/my/equipo/' + str(equipo.equipo.id) + '/historial/'"
                                            class="bg-primary"
                                            style="background-color: #714b67; box-sizing: border-box; text-decoration: none; color: white; padding: 2px 4px; border-radius: 3px;"><span
                                                class="base-fs" style="box-sizing:border-box;font-size:14px;">Ir a mi servicio
                                            </span>
                                        </a>
                                    </li>
                                    <li><strong style="box-sizing:border-box;font-weight:bolder;"><span class="base-fs"
                                                style="box-sizing:border-box;font-size:14px;">Marca: </span></strong><span
                                            class="base-fs" style="box-sizing:border-box;font-size:14px;"
                                            t-esc="equipo.equipo.marca">Samsung</span>
                                    </li>
                                    <li><strong style="box-sizing:border-box;font-weight:bolder;"><span class="base-fs"
                                                style="box-sizing:border-box;font-size:14px;">Modelo: </span></strong><span
                                            class="base-fs" style="box-sizing:border-box;font-size:14px;"
                                            t-esc="equipo.equipo.model">Monitor</span>
                                    </li>
                                    <li><strong style="box-sizing:border-box;font-weight:bolder;"><span class="base-fs"
                                                style="box-sizing:border-box;font-size:14px;">N° de serie: </span></strong><span
                                            class="base-fs" style="box-sizing:border-box;font-size:14px;"
                                            t-esc="equipo.equipo.serial_no">DS-23433</span></li>
                                    <li><strong style="box-sizing:border-box;font-weight:bolder;"><span class="base-fs"
                                                style="box-sizing:border-box;font-size:14px;">Plan de
                                                mantenimiento:
                                            </span></strong><span t-esc="equipo.plan.name" class="base-fs"
                                            style="box-sizing:border-box;font-size:14px;">Plan
                                            de 800 horas</span></li>
                                </ul>
                            </t>


                        </td>
                    </tr>

                    <tr
                        style="border-style:solid;box-sizing:border-box;border-left-width:0px;border-bottom-width:0px;border-right-width:0px;border-top-width:0px;border-left-color:inherit;border-bottom-color:inherit;border-right-color:inherit;border-top-color:inherit;padding: 10px; ">
                        <td
                            style="border-style:solid;box-sizing:border-box;border-left-width:0px;border-bottom-width:0px;border-right-width:0px;border-top-width:0px;border-left-color:inherit;border-bottom-color:inherit;border-right-color:inherit;border-top-color:inherit;padding: 10px;">
                            <span style="font-size: 11px;color: gray;">Si aun no cuentas con un usuario para nuestro portal,
                                contacte a <a t-att-href="'tel:' + str(object.create_uid.company_id.mobile)" style="text-decoration:none;box-sizing:border-box;color:#008f8c;" t-esc="object.create_uid.company_id.mobile"></a> para obtener acceso a todos sus servicios </span>
                        </td>
                    </tr>
                </tbody>

            </table>
            <div style="width: 700px; margin: 30px auto;">
                <table style="box-sizing:border-box;border-collapse:collapse;caption-side:bottom;">
                    <tbody
                        style="border-style:solid;box-sizing:border-box;border-left-width:0px;border-bottom-width:0px;border-right-width:0px;border-top-width:0px;border-left-color:inherit;border-bottom-color:inherit;border-right-color:inherit;border-top-color:inherit;">
                        <tr
                            style="border-style:solid;box-sizing:border-box;border-left-width:0px;border-bottom-width:0px;border-right-width:0px;border-top-width:0px;border-left-color:inherit;border-bottom-color:inherit;border-right-color:inherit;border-top-color:inherit;">
                            <td
                                style="border-style:solid;padding:0 10px 0 0;box-sizing:border-box;border-left-width:0px;border-bottom-width:0px;border-right-width:0px;border-top-width:0px;border-left-color:inherit;border-bottom-color:inherit;border-right-color:inherit;border-top-color:inherit;padding-right: 10px;">

                                <img t-attf-src="/logo.png?company={{ object.create_uid.company_id.id }}" width="120px"
                                    style="box-sizing: border-box; vertical-align: middle; ">
                            </td>
                            <td
                                style="border-style:solid;box-sizing:border-box;border-left-width:0px;border-bottom-width:0px;border-right-width:0px;border-top-width:0px;border-left-color:inherit;border-bottom-color:inherit;border-right-color:inherit;border-top-color:inherit;">
                                <strong style="box-sizing:border-box;font-weight:bolder;"
                                    t-esc="object.create_uid.company_id.name"></strong><br>
                                <span t-esc="object.create_uid.company_id.street">Av. Separadora Industrial 2103</span><br>
                                <span t-esc="object.create_uid.company_id.mobile"></span><br>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

        ]]>
    </field>
	</record>
</odoo>
