<odoo>
<!-- Acción exclusiva para técnicos: entra ya filtrado -->
<record id="action_model_tecnico" model="ir.actions.act_window">
    <field name="name">Mis Registros</field>
    <field name="res_model">crm.lead</field> <!-- ⬇️ tu modelo -->
    <field name="view_mode">tree,form,kanban,calendar,pivot,graph</field>
    <!-- Dominio en el action (aplicado siempre que usen este menú) -->
    <field name="domain">[('user_id', '=', uid)]</field>
    <!-- Activa el filtro "my_records" automáticamente -->
    <field name="context">{'search_default_my_records': 1}</field>
</record>

