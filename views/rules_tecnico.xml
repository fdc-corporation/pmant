            <field name="domain_force">
            ['&amp;',('tarea.create_uid','=',user.id),'|',('tarea.ots','=',False),('tarea.ots.user_id','=',user.id)]
            </field>
    </record>

    <!--REGLAS PARA TAREA, GRUPO  TECNCICO  -->
