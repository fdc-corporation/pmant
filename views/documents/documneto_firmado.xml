<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- FORMULARIO DE DOCUMENTOS SIN FIRMAR -->
    <record id="sign_template_inherit_form" model="ir.ui.view">
        <field name="name">sign.template.view.form.inherit</field>
        <field name="model">sign.template</field>
        <field name="inherit_id" ref="sign.sign_template_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="ot_id" readonly="1" />
                <field name="equipo_id" readonly="1" />
            </xpath>
        </field>
    </record>


    <record id="sign_send_request_inherit_form" model="ir.ui.view">
        <field name="name">sign.send.request.view.form.inherit</field>
        <field name="model">sign.send.request</field>
        <field name="inherit_id" ref="sign.sign_send_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='activity_id']" position="after">
                <field name="ot_id" readonly="1" />
                <field name="equipo_id" readonly="1" />
            </xpath>
        </field>
    </record>

    <record id="sign_requestrequest_inherit_form" model="ir.ui.view">
        <field name="name">sign.request.request.view.form.inherit</field>
        <field name="model">sign.request</field>
        <field name="inherit_id" ref="sign.sign_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='active']" position="after">
                <field name="ot_id" readonly="1" />
                <field name="equipo_id" readonly="1" />
            </xpath>
        </field>
    </record>

</odoo>
