<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="Equipo_addKANVAN" model="ir.ui.view">
		<field name="name">Equipament.Kanvan</field>
		<field name="model">maintenance.equipment</field>
		<field name="inherit_id" ref="maintenance.hr_equipment_view_kanban" />
		<field name="arch" type="xml">
			<xpath expr="//t[@t-name='card']" position="replace">
				<t t-name="card">
					<field name="service_in_progress" invisible="1"/>
					<field name="active_service_count" invisible="1"/>
					<div class="position-relative h-100 d-flex flex-column" style="min-height: 190px;">
						<div t-if="record.service_in_progress.raw_value"
							 class="text-bg-warning fw-bold text-center text-uppercase py-1 px-2 mb-3 rounded-top"
							 style="letter-spacing: .04em; margin: -8px -8px 0 -8px;">
							<i class="fa fa-wrench me-1" title="Servicio en ejecución"/>
							Servicio en ejecución
						</div>
						<div class="d-flex gap-3 align-items-start">
							<div class="flex-shrink-0 rounded border bg-light d-flex align-items-center justify-content-center overflow-hidden"
								 style="width: 64px; height: 64px;">
								<field name="image" widget="image" options="{'img_class': 'object-fit-cover w-100 h-100'}"
									   t-if="record.image.raw_value"/>
								<i t-else="" class="fa fa-cogs fa-2x text-muted" title="Equipo"/>
							</div>
							<div class="flex-grow-1 overflow-hidden">
								<div class="fw-bold fs-5 text-truncate" title="Nombre del equipo">
									<field name="name"/>
								</div>
								<div t-if="record.model.raw_value" class="text-muted text-truncate">
									<field name="model"/>
								</div>
								<div t-if="record.serial_no.raw_value" class="small font-monospace text-truncate">
									<field name="serial_no"/>
								</div>
							</div>
						</div>
						<div class="mt-3 small d-grid gap-1">
							<div t-if="record.propietario.raw_value" class="text-truncate">
								<i class="fa fa-building-o text-muted me-2" title="Propietario"/>
								<strong>Propietario:</strong> <field name="propietario"/>
							</div>
							<div t-if="record.ubicacion.raw_value" class="text-truncate">
								<i class="fa fa-map-marker text-muted me-2" title="Ubicación"/>
								<strong>Ubicación:</strong> <field name="ubicacion"/>
							</div>
							<div t-if="record.area.raw_value" class="text-truncate">
								<i class="fa fa-sitemap text-muted me-2" title="Área"/>
								<strong>Área:</strong> <field name="area"/>
							</div>
							<div t-if="record.service_in_progress.raw_value" class="text-warning-emphasis text-truncate mt-1">
								<i class="fa fa-play-circle me-2" title="Servicio activo"/>
								<field name="active_service_name"/>
								<span t-if="record.active_service_count.raw_value &gt; 1">
									(+<field name="active_service_count"/> activos)
								</span>
							</div>
						</div>
						<footer class="mt-auto pt-3 border-top">
							<div class="d-flex ms-auto align-items-center">
								<field name="activity_ids" widget="kanban_activity"/>
								<field name="owner_user_id" widget="many2one_avatar_user" class="ms-1"/>
							</div>
						</footer>
					</div>
				</t>
			</xpath>
		</field>
	</record>
	<record id="qr_add_product" model="ir.ui.view">
		<field name="name">qradd.view</field>
		<field name="model">maintenance.equipment</field>
		<field name="inherit_id" ref="maintenance.hr_equipment_view_form" />
		<field name="arch" type="xml">
			<xpath expr="//div[@name='button_box']" position="inside">
				<!-- BOTON DE COTIZACIONES -->
				<button class="oe_stat_button" type="object"  name="action_view_cotizaciones"
				icon="fa-pencil-square-o">
				<field string="Cotizacion" name="cotizacion_cantidad" widget="statinfo"/>
				</button>
				<button class="oe_stat_button" type="object" name="action_view_prox_mant" icon="fa-file-text-o">
					<field string="Proximos mantenimiento" name="count_recordatorios" widget="statinfo"/>
				</button>
				<button class="oe_stat_button" type="object" name="action_programacion_equipo" icon="fa-file-text-o">
					<field string="Historial de programaciones" name="count_programacion" widget="statinfo"/>
				</button>
			</xpath>
			<!-- ADD -->
			<xpath expr="//field[@name='employee_id']" position="after">
				<field name="propietario" />
				<field name="parent_id" invisible="1" />
				<field name="ubicacion" string="Ubicacion" domain="[('parent_id', '=', parent_id), ('is_area', '=', False)]" />
				<field name="area" domain="[('id_sede', '=', ubicacion), ('is_area', '=', True)]" />
			</xpath>
			<xpath expr="//field[@name='model']" position="after">
				<field name="marca" string="Marca" />
			</xpath>
			<xpath expr="//field[@name='partner_id']" position="after">
				<field name="fecha_compra" string="Fecha Compra" />
			</xpath>
			<xpath expr="//field[@name='fecha_compra']" position="after">
				<field name="fabricante" string="Fabricante" />
			</xpath>
			<xpath expr="//sheet" position="before">
				<header>
					<button name="programar_mantenimiento" type="object" string="Programar Mantenimiento" class="oe_highlight"/>
					<button name="generar_n_serie" string="Generar N° de serie" type="object" />
				</header>
			</xpath>
			<xpath expr="//field[@name='fabricante']" position="after">
				<field name="time_uso" string="Horas de uso Promedio diario" widget="float_time" />
			</xpath>
            <xpath expr="//field[@name='time_uso']" position="after">
				<field name="frecuencia_m" string="Frecuencia de Mantenimiento" />
			</xpath>
			<xpath expr="//sheet/notebook[1]" position="after">
				<notebook>
					<page string="Mantenimientos">
						<field name="planequipo" string="Mantenimientos Realizados" >
							<list>
								<field name="equipo" />
								<field name="plan" />
								<field name="estado" />
								<field name="fecha_ejec" />
								<button name="create_report_equipo" string="Generar Reporte" type="object" class="oe_highlight" />
							</list>
						</field>
						<group>
							<field name="fecha_prox" string="Proximo Mantenimiento" />
						</group>
					</page>
					<page name="otros_mant" string="Otros Mantenimientos">
						<field name="otros_mantenimientos" >
							<list>
								<field name="name" />
								<field name="fecha_ejec" />
								<field name="file_adjunto" />
								<field name="tipo" />
							</list>
							<form string="Subir reporte técnico">
								<group>
									<field name="name"/>
									<field name="equipo" readonly="1"/>
									<!-- <field name="planequipo"/> -->
									<field name="fecha_ejec"/>
									<field name="tipo"/>
									<field name="file_adjunto" filename="file_name" />
									<field name="file_name" invisible="1"/>
								</group>
							</form>
						</field>
						
					</page>
					<page string="Solicitudes de mantenimiento">
						<field name="solicitudes_servicio">
							<list>
								<field name="ubicacion_id" />
								<field name="estado" />
								<field name="tipo_servicio" />
								<field name="fecha_servicio" />
								<field name="detalle_problema" />
								<button name="create_tarea" invisible="estado in 'atendido'" string="Atender" type="object" class="oe_highlight" />
							</list>
							<form string="Solicitud de Mantenimiento">
								<sheet>
									<group>
										<group>
											<field name="equipo_id" required="1"/>
											<field name="ubicacion_id" required="1"/>
											<field name="tipo_servicio" required="1"/>
											<field name="fecha_servicio" required="1"/>
										</group>
										<group>
											<field name="estado" readonly="1"/>
											<field name="nombre_imagen" invisible="1"/>
											<field name="imagen_referencial" readonly="1" filename="nombre_imagen"/>
										</group>
									</group>
									<field name="detalle_problema" widget="text" colspan="4"/>
								</sheet>
							</form>
						</field>
					</page>
					<page string="Mediciones del equipo">
						<field name="mediciones" >
							<list editable="bottom">
								<field name="hora_uso" />
								<field name="temperatura_elemento" />
								<field name="presion_actual" />
								<field name="temperatura_ambiente" />
								<!-- <field name="equipo_id" /> -->
								<field name="fecha_registro" />
							</list>
						</field>
					</page>
					<page string="Certificados">
						<separator string="Certificados PDF firmados"/>
						<field name="certificados_manuales" context="{'default_equipo_id': id}">
							<list editable="bottom">
								<field name="fecha_firma"/>
								<field name="name"/>
								<field name="nombre_archivo"/>
								<field name="archivo_firmado" filename="nombre_archivo"/>
								<field name="origen" readonly="1"/>
								<field name="usuario_id" readonly="1"/>
							</list>
						</field>
					</page>
					<page string="QR Imagen">
						<group>
							<field name="qr_image" string="QR IMAGEN" widget="image" class="col-sm-2 col-md-3" options="{'preview_image': 'qr_image', 'size': [0, 90]}"  />
							<field name="qr_image2" string="Descargar QR" />
							<field name="url_qr" string="URL QR" />
						</group>
					</page>
					<page string="Adjuntos">
						<field name="adjunto" string="Adjunto" />
					</page>
					<page string="Documentos">
						<field name="documentos" string="Documentos" />
					</page>
				</notebook>
			</xpath>
			<!-- INVISIBLE -->
			<xpath expr="//field[@name='partner_ref']" position="attributes">
				<attribute name="invisible">
					True
				</attribute>
			</xpath>
			<!-- <xpath expr="//field[@name='location']" position="attributes">
				<attribute name="invisible">
					True
				</attribute>
			</xpath> -->
			<xpath expr="//field[@name='equipment_assign_to']" position="attributes">
				<attribute name="invisible">
					True
				</attribute>
			</xpath>
			<xpath expr="//page[3]" position="attributes">
				<attribute name="invisible">
					True
				</attribute>
			</xpath>
			<xpath expr="//field[@name='employee_id']" position="attributes">
				<attribute name="invisible">
					True
				</attribute>
			</xpath>
			<xpath expr="//field[@name='technician_user_id']" position="attributes">
				<attribute name="invisible">
					True
				</attribute>
			</xpath>
			<!-- Campos estándar que PMANT no utiliza en la ficha del equipo. -->
			<xpath expr="//field[@name='scrap_date']" position="attributes">
				<attribute name="invisible">True</attribute>
			</xpath>
			<xpath expr="//field[@name='location_id']" position="attributes">
				<attribute name="invisible">True</attribute>
			</xpath>
			<xpath expr="//field[@name='partner_id']" position="attributes">
				<attribute name="invisible">True</attribute>
			</xpath>
			<xpath expr="//field[@name='fecha_compra']" position="attributes">
				<attribute name="invisible">True</attribute>
			</xpath>
			<xpath expr="//field[@name='effective_date']" position="attributes">
				<attribute name="invisible">True</attribute>
			</xpath>
			<xpath expr="//field[@name='cost']" position="attributes">
				<attribute name="invisible">True</attribute>
			</xpath>
			<!-- Add image field below title -->
			<xpath expr="//div[@class='oe_title']" position="after">
				<div class="oe_image">
					<field name="image" widget="image" class="oe_avatar" style="width:128px;height:128px;" />
				</div>
			</xpath>
		</field>
	</record>
</odoo>
