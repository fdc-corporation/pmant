<odoo>
    <record id="view_partner_form_inherit_equipos" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.equipos</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/> <!-- Asegúrate de que el ID sea correcto -->
        <field name="arch" type="xml">
            <xpath expr="//div[@name='vat_vies_container']" position="after">
                <field name="tienen_areas"/>
                <field name="is_area" />
                <field name="id_sede" invisible="not is_area" domain="[('tienen_areas', '=', True)]"/>
            </xpath>
            <xpath expr="//field[@name='website']" position="before">
                <field name="email_jefe" />
            </xpath>
            <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='equipos']" position="attributes">
                <attribute name="invisible">parent_id</attribute>
              </xpath>
            <!-- Inserta una nueva página en el notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Equipos" invisible="is_tecnico" >
                    <field name="is_tecnico" invisible="true"></field>
                    <field name="equipos_ubicacion" >
                        <list string="Equipos">
                            <field name="name"/>
                            <field name="assign_date"/>
                            <field name="serial_no"/>
                            <field name="technician_user_id"/>
                            <field name="category_id"/>
                            <field name="serial_no"/>
                            <field name="company_id"/>
                        </list>                        
                    </field>
                </page>
                <page string="Areas" name="areas" invisible="not tienen_areas">
                    <field name="areas">
                        <list>
                            <field name="name"></field>
                            <field name="parent_id"></field>
                            <field name="email"></field>
                            <field name="phone"></field>
                            <field name="vat"></field>
                        </list>
                    </field>
                </page>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']" position="attributes">
                <attribute name="invisible">is_tecnico</attribute>
            </xpath>
            <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='equipos']" position="attributes">
                <attribute name="invisible">is_tecnico</attribute>
            </xpath>
            <!-- <xpath expr="//page[@name='sunat_details']" position="attributes">
                <attribute name="invisible">is_tecnico</attribute>
            </xpath> -->
            <xpath expr="//page[@name='accounting']" position="attributes">
                <attribute name="invisible">is_tecnico</attribute>
            </xpath>
        </field>
    </record>



    <record id="equipo_search_inherit" model="ir.ui.view">
        <field name="name">search.equipo.view.inherit</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search[1]/field[@name='name']" position="after">
                <field name="propietario"/>
            </xpath>
        </field>
    </record>


</odoo>
