										Orden de Trabajo
									</td>
								</tr>
								<tr class="">
									<td class="col-6">
										<strong>
											Orden:
										</strong>
										<span t-field="doc.name" />
									</td>
									<td class="col-6">
										<strong>
											Tipo de servicio:
										</strong>
