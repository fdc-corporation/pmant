<odoo>
    <template id="form_calificaciones" name="Formulario de Calificacion">
		<t t-call="website.layout">
			<t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/><t t-set="body_classname" t-value="'pmant-portal-page'"/>
			<t t-call="pmant.portal_section_nav"/>
            <div class="main pmant-form-page">
                <h2 style="text-align: center; font-size: 24px; color: #111827; font-weight: 600; margin-bottom: 16px;">
                    ¡Califica nuestro servicio!
                </h2>

                <p style="text-align: center; margin-bottom: 24px;">
                    Hola <strong><t t-out="object.empresa.name"/></strong>,<br/>
                    Nos encantaría conocer su calificación sobre la calidad y atención de nuestro servicio
                    <strong><t t-out="object.name"/></strong>.
                </p>

                <form action="/rate_service" method="post" style="display: block;">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <!-- Preguntas -->
                    <t t-set="preguntas" t-value="[
                        {'id': 'p1', 'texto': '1. ¿Qué tan satisfecho(a) está con la calidad del servicio recibido?'},
                        {'id': 'p2', 'texto': '2. ¿Qué tan satisfecho(a) está con el tiempo de respuesta y atención recibida?'},
                        {'id': 'p3', 'texto': '3. ¿Qué tan probable es que recomiende nuestro servicio a otras personas?'}
                    ]"/>
                    
                    <t t-foreach="preguntas" t-as="preg">
                        <div style="margin-bottom: 25px;">
                            <p><strong><t t-out="preg['texto']"/></strong></p>
                            <div style="display: flex; justify-content: center; gap: 10px; margin-top: 8px;">
                                <t t-foreach="[1,2,3,4,5]" t-as="i">
                                    <label>
                                        <input type="radio" t-att-name="preg['id']" t-att-value="i" required="required"/>
                                        <img t-att-src="'/pmant/static/src/img/rating_' + str(i) + '.png'"
                                             t-att-alt="'Calificación ' + str(i)"
                                             t-att-title="'Calificación ' + str(i)"
                                             width="40"
                                             style="cursor: pointer;"
                                             onerror="this.style.display='none'; this.insertAdjacentHTML('afterend', this.title);" />
                                    </label>
                                </t>
                            </div>
                        </div>
                    </t>

                    <!-- Comentarios -->
                    <div style="margin-bottom: 25px;">
                        <p><strong>Comentarios (opcional):</strong></p>
                        <textarea name="comment" style="width: 100%; height: 100px; padding: 10px; border-radius: 6px; border: 1px solid #ccc;"></textarea>
                    </div>

                    <!-- Enviar -->
                    <div style="text-align: center;">
                        <input type="hidden" name="order_id" t-att-value="object.id" />
                        <button type="submit" style="background-color: #008f8c; color: white; padding: 12px 24px; border: none; border-radius: 6px; font-weight: bold; cursor: pointer;">
                            Enviar respuestas
                        </button>
                    </div>
                </form>

                <div style="margin-top: 25px; text-align: center;">
                    <small style="color: gray; font-size: 11px;">
                        Si aún no cuentas con un usuario para nuestro portal, contacte a
                        <a t-att-href="'tel:' + str(object.create_uid.company_id.phone or '')" style="text-decoration: none; color: #008f8c;">
                            <t t-esc="object.create_uid.company_id.phone or ''"></t>
                        </a>
                        para obtener acceso a todos sus servicios.
                    </small>
                </div>
            </div>
        </t>
    </template>
</odoo>
