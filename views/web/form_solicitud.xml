<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="form_solicitud" name="Solicitar Servicio">
        <t t-call="website.layout">
            <t t-set="no_header" t-value="True"/><t t-set="no_footer" t-value="True"/><t t-set="body_classname" t-value="'pmant-portal-page'"/>
            <t t-call="pmant.portal_section_nav"/>
            <div class="main pmant-form-page">
                <header class="pmant-form-header"><span class="pmant-eyebrow">NUEVA SOLICITUD</span><h1>Solicitar mantenimiento</h1><p>Complete los datos para que el equipo técnico programe la atención.</p></header>
                <form action="/solicitud/mantenimiento/servicio" method="post" enctype="multipart/form-data" class="pmant-form-card">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><input type="hidden" name="id_equipo" t-att-value="equipo.id"/><input type="hidden" name="ubicacion_id" t-att-value="equipo.ubicacion.id"/>
                    <section><h2><i class="fa fa-cog"/> Equipo</h2><div class="pmant-form-grid"><label>Equipo<input type="text" t-att-value="equipo.name" readonly="readonly"/></label><label>Marca<input type="text" t-att-value="equipo.marca or ''" readonly="readonly"/></label><label>Modelo<input type="text" t-att-value="equipo.model or ''" readonly="readonly"/></label><label>Número de serie<input type="text" t-att-value="equipo.serial_no or ''" readonly="readonly"/></label></div></section>
                    <section><h2><i class="fa fa-wrench"/> Servicio solicitado</h2><div class="pmant-form-grid"><label>Tipo de servicio <span>*</span><select name="tipo_servicio" required="required"><option value="">Seleccione una opción</option><option value="Preventivo">Preventivo</option><option value="Correctivo">Correctivo</option><option value="Instalación">Instalación</option><option value="Evaluación">Evaluación</option></select></label><label>Fecha solicitada <span>*</span><input type="date" name="fecha_servicio" required="required"/></label><label class="pmant-form-wide">Descripción del problema <span>*</span><textarea name="razon" rows="5" required="required" placeholder="Describa síntomas, mensajes de error o comportamiento del equipo."/></label><label class="pmant-form-wide">Imagen de referencia<input type="file" name="formFileMultiple" accept="image/*"/><small>Adjunte una imagen clara si está disponible.</small></label></div></section>
                    <footer class="pmant-form-actions"><a t-att-href="'/my/equipos/%s/detalles' % equipo.id" class="btn btn-secondary">Cancelar</a><button type="submit" class="btn btn-primary"><i class="fa fa-paper-plane"/> Enviar solicitud</button></footer>
                </form>
            </div>
        </t>
    </template>
</odoo>
