<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<template id="solicitudes_servicio" name="Solicitudes de Servicios">
		<t t-call="website.layout">
			<div class="main">
				<div class="card-contacto-main">
					<div class="card-contacto">
						<div class="text-contacto">
							<img src="/pmant/static/src/css/iconos/icon-ct.png" alt="Icono Compresores de tornillo" />
							<span>
								Compresores de Tornillo S.A.C.
							</span>
						</div>
						<div class="contactar">
							<a href="/contactus" class="bg-primary">
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" id="customer-care">
									<path d="M54,27.29v-.35a21.94,21.94,0,1,0-43.88.12v.2A7,7,0,0,0,5,34v2a7,7,0,0,0,7,7h1.05A13,13,0,0,0,26,55h6a5,5,0,0,0,5-5V49a1,1,0,0,0-1-1H28a1,1,0,0,0-1,1v4H26A11,11,0,0,1,15,42V28a1,1,0,0,0-1-1H12.12A19.94,19.94,0,1,1,52,26.94V27H50a1,1,0,0,0-1,1V42a1,1,0,0,0,1,1h2a7,7,0,0,0,7-7V34A7,7,0,0,0,54,27.29ZM29,50h6a3,3,0,0,1-3,3H29ZM13,41H12a5,5,0,0,1-5-5V34a5,5,0,0,1,5-5h1Zm44-5a5,5,0,0,1-5,5H51V29h1a5,5,0,0,1,5,5Z">
									</path>
								</svg>
								Contactar
							</a>
						</div>
					</div>
					<div class="main-card-detalles-equipo">
						<div class="detalle-equipo-header">
							<div class="name-equipo">
								<label>
									Nombre
								</label>
								<h4 t-esc="equipo.name">
								</h4>
								<!--
								<button href="" type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exampleModal">
								Solicitar servicio
								</button>
								-->
							</div>
							<div class="img-header-equipo">
								<img t-att-src="'/web/image?model=maintenance.equipment&amp;id=%s&amp;field=image' % equipo.id" alt="Imagen del equipo" />
								<img t-att-src="'/web/image?model=maintenance.equipment&amp;id=%s&amp;field=qr_image' % equipo.id" alt="Qr del equipo" />
							</div>
							<!--
							<button href="" type="button" class="btn btn-primary btn-mobile" data-bs-toggle="modal" data-bs-target="#exampleModal">
							Solicitar servicio
							</button>
							-->
						</div>
						<div class="descripcion-propieadades-equipo">
							<div class="propiedades-contenedor">
								<div class="propiedad">
									<label>
										Propietario :
									</label>
									<span t-esc="equipo.propietario.name">
									</span>
								</div>
								<t t-if="">
									<div class="propiedad">
										<label>
											Ubicación :
										</label>
										<span t-esc="equipo.ubicacion.name">
										</span>
									</div>
								</t>
							</div>
							<div class="propiedades-contenedor">
								<div class="propiedad">
									<label>
										Categoría :
									</label>
									<span t-esc="equipo.category_id.name">
									</span>
								</div>
								<div class="propiedad">
									<label>
										Fecha asignada :
									</label>
									<span t-esc="equipo.assign_date.strftime('%d/%m/%Y') if equipo.assign_date else ''">
									</span>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="main-card-equipos">
					<div style="display:flex;flex-flow: row wrap;justify-content: space-between;gap: 0px;align-items: center;">
						<h3>
							Mis solicitudes de servicio
						</h3>
						<div style="display:flex; gap:10px;">
							<!-- Example single danger button -->
							<div class="btn-group">
								<div>
									<button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
										<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-filter-right" viewBox="0 0 16 16">
											<path d="M14 10.5a.5.5 0 0 0-.5-.5h-3a.5.5 0 0 0 0 1h3a.5.5 0 0 0 .5-.5m0-3a.5.5 0 0 0-.5-.5h-7a.5.5 0 0 0 0 1h7a.5.5 0 0 0 .5-.5m0-3a.5.5 0 0 0-.5-.5h-11a.5.5 0 0 0 0 1h11a.5.5 0 0 0 .5-.5" />
										</svg>
									</button>
									<ul class="dropdown-menu">
										<li>
											<a class="dropdown-item" t-att-href="'/my/equipo/' + str(equipo.id) + '/solicitudes/servicios?sort=asc'">
												<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-up-short" viewBox="0 0 16 16">
													<path fill-rule="evenodd" d="M8 12a.5.5 0 0 0 .5-.5V5.707l2.146 2.147a.5.5 0 0 0 .708-.708l-3-3a.5.5 0 0 0-.708 0l-3 3a.5.5 0 1 0 .708.708L7.5 5.707V11.5a.5.5 0 0 0 .5.5" />
												</svg>
												Ascendente
											</a>
										</li>
										<li>
											<a class="dropdown-item" t-att-href="'/my/equipo/' + str(equipo.id) + '/solicitudes/servicios?sort=desc'">
												<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-down-short" viewBox="0 0 16 16">
													<path fill-rule="evenodd" d="M8 4a.5.5 0 0 1 .5.5v5.793l2.146-2.147a.5.5 0 0 1 .708.708l-3 3a.5.5 0 0 1-.708 0l-3-3a.5.5 0 1 1 .708-.708L7.5 10.293V4.5A.5.5 0 0 1 8 4" />
												</svg>
												Descendente
											</a>
										</li>
									</ul>
								</div>
							</div>
						</div>
					</div>
					<div class="main-equipos">
						<t t-if="len(solicitudes) > 0">
							<t t-foreach="solicitudes" t-as="solicitud">
								<a class="card-equipo card-solicitud">
									<t t-if="solicitud.estado == 'nuevo'">
										<img src="/pmant/static/src/css/iconos/alerta.png" alt="Icon alerta mantenimiento" />
									</t>
									<t t-if="solicitud.estado == 'atendido'">
										<img src="/pmant/static/src/css/iconos/atendido.png" alt="Icon solicitud atendida" />
									</t>
									<div class="text-card-equipo">
										<strong>
											Tipo de servicio:
											<t t-esc="solicitud.tipo_servicio">
											</t>
											<t t-if="solicitud.estado == 'nuevo'">
												<span class="status-alert">
													Solicitado
												</span>
											</t>
											<t t-if="solicitud.estado == 'atendido'">
												<span class="status-atencion">
													Atendido
												</span>
											</t>
										</strong>
										<hr>
										</hr>
                                            <span  >
                                                 Fecha de servicio: <t t-esc="solicitud.fecha_servicio.strftime('%d/%m/%Y')"></t>
                                            </span>
										
										<t t-if="solicitud.detalle_problema">
												<strong style="font-size:12.5px;">
													Detalles:
												</strong>
												<span t-esc="solicitud.detalle_problema" />
										</t>
									</div>
								</a>
							</t>
						</t>
						<t t-else="">
							<div>
								Si no encuentra algun problema en ver sus solicitudes de servicios llame a
								<a href="tel:51908912551">
									+51 908 912 551
								</a>
								.
							</div>
						</t>
					</div>
					<!-- Paginación -->
					<div class="contenedor-paginacion">
						<nav aria-label="pagination justify-content-center">
							<ul class="pagination">
								<!-- Página anterior -->
								<li t-if="page &gt; 1" class="page-item">
									<a t-att-href="'/my/equipo/%s/solicitudes/servicios?page=%s&amp;sort=%s' % (equipo.id, page - 1, sort)" class="page-link" aria-label="Previous">
										<span class="page-link">
											« Anterior
										</span>
									</a>
								</li>
								<!-- Enlaces a cada página -->
								<t t-foreach="range(1, total_pages + 1)" t-as="p">
									<li t-attf-class="page-item #{'active' if p == page else ''}">
										<a t-att-href="'/my/equipo/%s/solicitudes/servicios?page=%s&amp;sort=%s' % (equipo.id, p, sort)" class="page-link">
											<t t-esc="p" />
										</a>
									</li>
								</t>
								<!-- Página siguiente -->
								<li t-if="page &lt; total_pages" class="page-item">
									<a t-att-href="'/my/equipo/%s/solicitudes/servicios?page=%s&amp;sort=%s' % (equipo.id, page + 1, sort)" class="page-link" aria-label="Next">
										<span class="page-link">
											Siguiente »
										</span>
									</a>
								</li>
							</ul>
						</nav>
					</div>
				</div>
			</div>
		</t>
	</template>
</odoo>
