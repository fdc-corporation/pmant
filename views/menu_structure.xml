<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Estructura comercial de PMANT, alineada con kd_pmant pero limitada
         estrictamente a las acciones que existen en este módulo. -->
    <record id="maintenance.menu_m_dashboard" model="ir.ui.menu">
        <field name="name">Tablero</field>
        <field name="sequence">10</field>
        <field name="group_ids" eval="[(6, 0, [ref('pmant.group_pmant_tecnico'), ref('pmant.group_pmant_planner'), ref('pmant.group_pmant_supervisor'), ref('pmant.group_pmant_admin')])]"/>
    </record>

    <record id="maintenance.menu_m_request" model="ir.ui.menu">
        <field name="name">Mantenimiento</field>
        <field name="sequence">20</field>
        <field name="group_ids" eval="[(6, 0, [ref('pmant.group_pmant_tecnico'), ref('pmant.group_pmant_planner'), ref('pmant.group_pmant_supervisor'), ref('pmant.group_pmant_admin'), ref('pmant.group_pmant_proveedor'), ref('pmant.group_pmant_vendedor')])]"/>
    </record>
    <record id="maintenance.menu_m_request_form" model="ir.ui.menu">
        <field name="name">Órdenes de trabajo</field>
        <field name="sequence">10</field>
        <field name="group_ids" eval="[(6, 0, [ref('pmant.group_pmant_tecnico'), ref('pmant.group_pmant_planner'), ref('pmant.group_pmant_supervisor'), ref('pmant.group_pmant_admin'), ref('pmant.group_pmant_proveedor'), ref('pmant.group_pmant_vendedor')])]"/>
    </record>
    <record id="maintenance.hr_equipment_request_action" model="ir.actions.act_window">
        <field name="name">Órdenes de trabajo</field>
    </record>
    <record id="menu_offline_technician" model="ir.ui.menu">
        <!-- Se evita duplicar el acceso a las órdenes dentro de Mantenimiento. -->
        <field name="active" eval="False"/>
    </record>
    <record id="tarea_menuv" model="ir.ui.menu">
        <field name="name">Tareas de mantenimiento</field>
        <field name="parent_id" ref="maintenance.menu_m_request"/>
        <field name="sequence">20</field>
        <field name="group_ids" eval="[(6, 0, [ref('pmant.group_pmant_tecnico'), ref('pmant.group_pmant_planner'), ref('pmant.group_pmant_supervisor'), ref('pmant.group_pmant_admin'), ref('pmant.group_pmant_proveedor')])]"/>
    </record>
    <record id="tarea_list_action" model="ir.actions.act_window">
        <field name="name">Tareas de mantenimiento</field>
    </record>
    <record id="maintenance.menu_m_request_calendar" model="ir.ui.menu">
        <field name="name">Calendario de mantenimiento</field>
        <field name="sequence">30</field>
        <field name="group_ids" eval="[(6, 0, [ref('pmant.group_pmant_tecnico'), ref('pmant.group_pmant_planner'), ref('pmant.group_pmant_supervisor'), ref('pmant.group_pmant_admin'), ref('pmant.group_pmant_proveedor')])]"/>
    </record>
    <record id="maintenance.hr_equipment_request_action_cal" model="ir.actions.act_window">
        <field name="name">Calendario de mantenimiento</field>
    </record>
    <record id="menu_sale_general_settings" model="ir.ui.menu">
        <!-- La configuración comercial no corresponde al menú operativo. -->
        <field name="active" eval="False"/>
    </record>

    <record id="recepcion_menu_pmant" model="ir.ui.menu">
        <field name="name">Recepción de equipos</field>
        <field name="parent_id" ref="maintenance.menu_maintenance_title"/>
        <field name="sequence">30</field>
    </record>
    <record id="maintenance.menu_equipment_form" model="ir.ui.menu">
        <field name="name">Equipos</field>
        <field name="sequence">40</field>
        <field name="group_ids" eval="[(6, 0, [ref('pmant.group_pmant_tecnico'), ref('pmant.group_pmant_planner'), ref('pmant.group_pmant_supervisor'), ref('pmant.group_pmant_admin'), ref('pmant.group_pmant_proveedor')])]"/>
    </record>
    <record id="maintenance.menu_m_reports" model="ir.ui.menu">
        <field name="name">Reportes</field>
        <field name="sequence">70</field>
    </record>
    <record id="maintenance.maintenance_request_reporting" model="ir.ui.menu">
        <field name="parent_id" ref="maintenance.menu_m_reports"/>
        <field name="sequence">10</field>
    </record>
    <record id="maintenance.maintenance_reporting" model="ir.ui.menu">
        <!-- Se consolida su contenido en menu_m_reports para no duplicar Reportes. -->
        <field name="active" eval="False"/>
    </record>
    <record id="horas_trabajo_menu" model="ir.ui.menu">
        <field name="name">Horas de trabajo</field>
        <field name="parent_id" ref="maintenance.menu_m_reports"/>
        <field name="sequence">20</field>
    </record>

    <record id="maintenance.menu_maintenance_configuration" model="ir.ui.menu">
        <field name="name">Configuración</field>
        <field name="sequence">100</field>
        <field name="group_ids" eval="[(6, 0, [ref('pmant.group_pmant_planner'), ref('pmant.group_pmant_admin')])]"/>
    </record>
    <record id="menu_conf_pmant_ubicacion" model="ir.ui.menu">
        <field name="name">Ubicaciones de mantenimiento</field>
        <field name="sequence">10</field>
    </record>
    <record id="maintenance.menu_maintenance_teams" model="ir.ui.menu">
        <field name="name">Áreas de trabajo</field>
        <field name="sequence">20</field>
    </record>
    <record id="maintenance.menu_maintenance_cat" model="ir.ui.menu">
        <field name="name">Categorías de equipos</field>
        <field name="sequence">30</field>
    </record>
    <record id="maintenance.menu_maintenance_stage_configuration" model="ir.ui.menu">
        <field name="name">Etapas de órdenes de trabajo</field>
        <field name="sequence">40</field>
    </record>
    <record id="etapa_tarea" model="ir.ui.menu">
        <field name="name">Etapas de tarea</field>
        <field name="sequence">50</field>
    </record>
    <record id="plantarea_menuv" model="ir.ui.menu">
        <field name="name">Planes de mantenimiento</field>
        <field name="parent_id" ref="maintenance.menu_maintenance_configuration"/>
        <field name="sequence">60</field>
    </record>
    <record id="tipoplan_menu" model="ir.ui.menu">
        <field name="name">Frecuencias de mantenimiento</field>
        <field name="sequence">70</field>
    </record>
    <record id="grupoprocesos_menuv" model="ir.ui.menu">
        <field name="name">Grupos de procesos</field>
        <field name="sequence">80</field>
    </record>
    <record id="plantilla_estadoproc" model="ir.ui.menu">
        <field name="name">Estados de proceso</field>
        <field name="sequence">90</field>
    </record>
    <record id="menu_pmant_checklist" model="ir.ui.menu">
        <field name="name">Plantillas de checklist</field>
        <field name="sequence">100</field>
    </record>
</odoo>
