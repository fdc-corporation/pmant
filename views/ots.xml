<?xml version="1.0" encoding="UTF-8"?>
<odoo>


	  <!-- Definición de la Secuencia -->
	  <record id="seq_ot_mantenimiento" model="ir.sequence">
		<field name="name">OT mantenimiento</field>
		<field name="code">ot.mantenimiento.sequence</field>
		<field name="prefix">OT/</field>
		<field name="padding">4</field>
		<field name="number_next">1</field>
		<field name="number_increment">1</field>
	</record>





	<record id="ots_add" model="ir.ui.view">	
		<field name="name">ots.view</field>
		<field name="model">maintenance.request</field>
		<field name="inherit_id" ref="maintenance.hr_equipment_request_view_form" />
		<field name="arch" type="xml">
			<xpath expr="//button[@name='reset_equipment_request']" position="after">
				<button name="action_print_report"  type="object" string="Generar Reporte" class="oe_highlight" />
				<button groups="pmant.group_pmant_admin,pmant.group_pmant_planner"  string="Enviar correo a la Empresa" name="send_report_empresa" type="object" />
				<button groups="pmant.group_pmant_admin,pmant.group_pmant_planner"  string="Enviar correo a la Sucursal" name="send_report_sucursal" type="object" />
				<button groups="pmant.group_pmant_admin,pmant.group_pmant_planner"  name="crm_oportunidad_create" invisible="stage_id in (1, 2)" type="object" string="Crear Oportunidad" class="oe_highlight" />
				<button groups="pmant.group_pmant_admin,pmant.group_pmant_planner"  name="set_firma_cliente_mantenimiento"  type="object" string="Solicitar firma del Servicio" class="oe_highlight" />
				<button groups="pmant.group_pmant_admin,pmant.group_pmant_planner"  name="open_wizard_firma_empresa_acta" type="object" string="Solicitar firma de Acta" class="oe_highlight" />
				<button groups="pmant.group_pmant_admin,pmant.group_pmant_planner"  class="oe_stat_button"
						type="object"
						name="action_open_wizard"
						icon="fa-whatsapp"
						context="{'default_partner_id': empresa.id, 'full_name': True}">
					<span class="o_stat_info">Enviar</span>
				</button>
				<button name="action_fech_up" groups="pmant.group_pmant_admin,pmant.group_pmant_planner" invisible="stage_id != 3"  type="object" string="Actualizar Fecha Ejec." class="oe_highlight" />

			</xpath>
			<xpath expr="//div[@class='oe_title']" position="before">
                <widget name="web_ribbon" title="Requiere Repuestos" bg_color="text-bg-warning" invisible="not require_repuestos"/>
			</xpath>
			<xpath expr="//field[@name='maintenance_type']" position="after">
				<field name="id" invisible="1" />
				<!-- <field name="estado" invisible="1" /> -->
				<field name="tex" invisible="1" />
				<field name="fecha_ejec" invisible="stage_id in (1,2)" readonly="1" />
				<field name="fecha_acta" invisible="1" readonly="1" />
				<!-- <field name="activity_ids" widget="kanban_activity"/> -->
				<field name="tarea" string="Tarea" domain="[('ots', '=', False)]" context="{'default_ots2': id }" />
				<field name="empresa" readonly="1" />
				<field name="ubicacion" readonly="1" />
				<field name="oportunidad" readonly="1"/>
				<field name="is_tecnico" invisible="1"/>
				<!-- <field name="order_compra" invisible="is_tecnico"  options="{'no_quick_create': true, 'no_create_edit': true}"  domain="['|', ('cliente', '=', empresa), ('cliente', '=', ubicacion)]" /> -->
				<!-- <field name="not_oc" /> -->
				<field name="selec_sunat" invisible="stage_id in (1, 2, 3)" />
				<field name="factura_sunat"  invisible="not selec_sunat"/>
                <field name="factura"  invisible="stage_id in (1, 2, 3) and selec_sunat or is_tecnico"  options="{'no_quick_create': true, 'no_create_edit': true}"  domain="[('partner_id', '=', empresa)]"  />
			</xpath>
			<xpath expr="//field[@name='schedule_date']" position="before">
				<field name="subodinados" widget="many2many_avatar_user" ></field>
			</xpath>
			<xpath expr="//field[@name='schedule_date']" position="before">
				<field name="is_active_programacion" invisible="1" ></field>
			</xpath>
			<xpath expr="//field[@name='priority']" position="after">
				<field name="duration" ></field>
			</xpath>
			<xpath expr="//page" position="after">
				<page string="Programación">
					<div class="oe_button_box" name="button_box" invisible="is_tecnico">
						<button name="action_view_incidencias" type="object" class="oe_stat_button" icon="fa-file-text-o">
							<field name="cantidad_inconvenientes" string="Incidencias" widget="statinfo"/>
						</button>
					</div>
						<field name="tab_horas" readonly="is_tecnico">
							<list editable="bottom">
								<field name="fecha_date" />
								<field name="duracion" widget="float_time"  />
								<field name="tecnicos" widget="many2many_avatar_user"  />
								<field name="event_calendario" readonly="1"  />
								<field name="horas_active" column_invisible="1"  />
								<field name="fecha_inicio" readonly="1"  />
								<field name="fecha_fin" readonly="1" />
								<field name="horas_trabajado" widget="float_time" readonly="1" />
								<button name="action_view_registro" class="btn btn-link" type="object" string="Detalles"></button>
								<!-- <button name="cancel_cronograma" invisible="not horas_active"  type="object" string="Cancelar"></button> -->
								<!-- <button name="init_cronograma" type="object" string="Calendario"></button> -->
							</list>
						</field>
				</page>
				<page groups="pmant.group_pmant_admin,pmant.group_pmant_planner"  string="Calificaciones">
					<group >
						<field name="rating_p1" />
						<field name="rating_p2" />
						<field name="rating_p3" />
						<field name="rating_comment" />
					</group>
				</page>
				<!-- <page string="Acta firmado">
					<field name="acta_firmado" widget="pdf_viewer"/>
				</page> -->
			</xpath>
			<xpath expr="//sheet/div[@invisible='not archive']" position="before">
				<div groups="pmant.group_pmant_admin,pmant.group_pmant_planner"  class="oe_button_box" name="button_box">
						<button class="oe_stat_button" type="object" name="action_view_documentos"
								icon="fa-file-text-o">
								<field string="Documentos firmados" name="document_count" widget="statinfo"/>
						</button>
				</div>
			</xpath>

			<!-- LIMITRAR VISIVILIDA DE CAMPOSEN ORDENER DE TRABAJO -->
			<xpath expr="//field[@name='maintenance_team_id']" position="attributes">
				<attribute name="invisible" >is_tecnico</attribute>
			</xpath>
			<xpath expr="//field[@name='subodinados']" position="attributes">
				<attribute name="user_id">many2many_avatar_user</attribute>
			  </xpath>
			<xpath expr="//field[@name='close_date']" position="attributes">
				<attribute name="invisible">
					True
				</attribute>
			</xpath>
			<xpath expr="//field[@name='email_cc']" position="attributes">
				<attribute name="invisible">
					True
				</attribute>			</xpath>
			<xpath expr="//field[@name='category_id']" position="attributes">
				<attribute name="invisible">
					True
				</attribute>
			</xpath>
			<xpath expr="//field[@name='equipment_id']" position="attributes">
				<attribute name="invisible">
					True
				</attribute>
			</xpath>
			<xpath expr="//field[@name='maintenance_type']" position="attributes">
				<attribute name="invisible">
					True
				</attribute>
			</xpath>

			<!-- CAMPOS SOLO LECTURA EN EL MODELO ORDENES DE MANTENIMIENTO -->
			<xpath expr="//field[@name='employee_id']" position="attributes">
				<attribute name="readonly" >is_tecnico</attribute>
			</xpath>
			<xpath expr="//field[@name='user_id']" position="attributes">
				<attribute name="readonly" >is_tecnico</attribute>
			</xpath>
			<xpath expr="//field[@name='schedule_date']" position="attributes">
				<attribute name="readonly" >is_tecnico</attribute>
			</xpath>
			<xpath expr="//field[@name='subodinados']" position="attributes">
				<attribute name="readonly" >is_tecnico</attribute>
			</xpath>
			
			<!-- <xpath expr="//field[@name='duration']" position="attributes">
				<attribute name="readonly" >is_tecnico</attribute>
				<attribute name="required" >1</attribute>
			</xpath> -->
			<xpath expr="//field[@name='priority']" position="attributes">
				<attribute name="readonly" >is_tecnico</attribute>
			</xpath>
			<xpath expr="//field[@name='email_cc']" position="attributes">
				<attribute name="readonly" >is_tecnico</attribute>
			</xpath>
			<xpath expr="//field[@name='company_id']" position="attributes">
				<attribute name="readonly" >is_tecnico</attribute>
			</xpath>
		</field>
	</record>
	<!-- FIN VISTA MAINTANCE REQUEST -->


	<!-- VISTA KANBAN -->
	<record id="view_form_kanban_ot_id" model="ir.ui.view">
		<field name="name">maintenance.request.view.kanban.inherit</field>
		<field name="model">maintenance.request</field>
		<field name="inherit_id" ref="maintenance.hr_equipment_request_view_kanban"/>
		<field name="arch" type="xml">
			<xpath expr="//t[@t-name='card']" position="replace">
				<t t-name="card">
	                <widget name="web_ribbon" title="Repuestos" bg_color="text-bg-warning" invisible="not require_repuestos"/>
					<div>
						<div class="titulo d-flex align-items-center gap-2">
							<field class="fw-bold fs-5" name="name"/>
							<div class="content_name"/></div>
						<!-- <hr class="mt-1 mb-1"/> -->
						<!-- Creado por -->
						<div class="cliente d-flex align-items-center mb-1">
							<span class="me-1">
								<i class="fa fa-user" style="font-size:16px;"/>
							</span>
							<t t-if="record.employee_id.raw_value">
								<span >
									<field name="employee_id"/>
								</span>
							</t>
							<t t-else="">
								<span>No tiene usuario creado</span>
							</t>
						</div>
						<div class="d-none">
							<span class="d-none hidden" name="owner_user_id" t-if="record.owner_user_id.raw_value">Solicitado por: 
								<field name="owner_user_id"/>
							</span>
						</div>
						<!-- Cliente -->
						<div class="cliente d-flex align-items-center mb-1">
							<span class="me-1">
								<i class="fa fa-building" style="font-size:16px;"/>
							</span>
							<t t-if="record.empresa.raw_value">
								<field name="empresa"/>
							</t>
							<t t-else="">
								<span>Sin cliente</span>
							</t>
						</div>
						<!-- Ubicación -->
						<div class="ubicacion d-flex align-items-center mb-1">
							<span class="me-1">
								<i class="fa fa-truck" style="font-size:16px;"/>
							</span>
							<t t-if="record.ubicacion.raw_value">
								<field name="ubicacion"/>
							</t>
							<t t-else="">
								<span>Sin ubicacion de servicio</span>
							</t>
						</div>
						<div class="row g-0">
							<!-- Fecha de solicitud -->
							<div class="col-3 d-flex align-items-center gap-1 flex-nowrap mb-1">
								<i class="fa fa-calendar " style="font-size:14px;"/>
								<t t-if="record.request_date.raw_value">
									<field name="request_date" class="text-truncate"/>
								</t>
								<t t-else="">
									<span class=" text-truncate" style="font-size:12px;">Sin solicitud</span>
								</t>
							</div>
							<!-- Fecha de servicio -->
							<div class="col-5 d-flex pe-3 align-items-center gap-1 flex-nowrap mb-1">
								<i class="fa fa-calendar " style="font-size:14px;"/>
								<t t-if="record.schedule_date.raw_value">
									<field name="schedule_date" class="text-truncate"/>
								</t>
								<t t-else="">
									<span class=" text-truncate" style="font-size:12px;">Sin servicio</span>
								</t>
							</div>
							<!-- Duración -->
							<div class="col-4 d-flex align-items-center gap-1 flex-nowrap mb-1">
								<i class="fa fa-clock-o " style="font-size:14px;"/>
								<t t-if="record.duration.raw_value">
									<field name="duration" class="text-truncate"/>
								</t>
								<t t-else="">
									<span class=" text-truncate" style="font-size:12px;">Sin duración</span>
								</t>
							</div>
						</div>
					</div>
					<footer>
						<div class="d-flex">
							<field name="priority" widget="priority"/>
							<field name="activity_ids" widget="kanban_activity" class="ms-3"/>
						</div>
						<div class="d-flex ms-auto align-items-center">
							<div class="badge text-bg-warning float-end" invisible="not archive">
											Cancelado
										</div>
							<field name="kanban_state" widget="state_selection" class="ms-1"/>
							<field name="user_id" widget="many2one_avatar_user" class="ms-1"/>
						</div>
					</footer>
				</t>
			</xpath>
		</field>
	</record>


	<record id="view_maintenance_request_filter_pmant" model="ir.ui.view">
		<field name="name">maintenance.request.search</field>
		<field name="model">maintenance.request</field>
		<field name="inherit_id" ref="maintenance.hr_equipment_request_view_search"/>
		<field name="arch" type="xml">
			<xpath expr="//field[@name='name']" position="before">
				<field name="empresa" string="Cliente" />
			</xpath>	
		</field>
	</record>
</odoo>
